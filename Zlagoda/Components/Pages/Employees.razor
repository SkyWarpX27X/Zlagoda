@page "/employees"
@rendermode InteractiveServer
@using Zlagoda.ViewModels
@using Zlagoda.Components.ItemViews
@using Zlagoda.Components.ItemModifies
@inject EmployeesVM ViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Працівники</h3>
    <button class="btn btn-outline-primary" @onclick="PrintReport">
        <i class="bi bi-printer me-1"></i> Друк звіту
    </button>
</div>

@if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @ViewModel.ErrorMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="ViewModel.ClearError"></button>
    </div>
}

<div class="mb-3">
    @if (ViewModel.IsCreating && ViewModel.NewEmployee != null)
    {
        <div class="w-100 mb-3">
            <EmployeeModify Employee="@ViewModel.NewEmployee" IsNew="true" OnSave="@ViewModel.SaveNewEmployee" OnCancel="@ViewModel.CancelCreate" />
        </div>
    }
    else
    {
        <button class="btn btn-success mb-3" @onclick="ViewModel.ShowCreateNew">Додати працівника</button>
    }
    
    <div class="card bg-light p-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <label for="searchSurname" class="form-label fw-bold">Пошук за прізвищем:</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" id="searchSurname" class="form-control" placeholder="Введіть прізвище..." @bind="ViewModel.SearchSurname" @bind:event="oninput" />
                </div>
            </div>
            
            <div class="col-md-6">
                <label for="roleFilter" class="form-label fw-bold">Фільтр:</label>
                <select id="roleFilter" class="form-select" @bind="ViewModel.RoleFilter">
                    <option value="All">Всі працівники</option>
                    <option value="Cashier">Тільки касири</option>
                </select>
            </div>
        </div>
    </div>
</div>

@if (ViewModel.Employees == null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <div class="employee-list" style="max-height: 70vh; overflow-y: auto; padding-right: 10px;">
        @foreach (var employee in ViewModel.Employees)
        {
            <EmployeeView Employee="@employee" OnSave="ViewModel.EditEmployee" OnDelete="ViewModel.DeleteEmployee"/>
        }
        
        @if (!ViewModel.Employees.Any())
        {
            <div class="alert alert-info mt-2">Не знайдено працівників за вказаними критеріями.</div>
        }
    </div>
}

@code {
    private async Task PrintReport()
    {
        // TODO: Implement printing logic
    }
}
